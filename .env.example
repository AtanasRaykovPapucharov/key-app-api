# Copy to .env (never commit .env). On your host, set these as environment variables.

NODE_ENV=development
PORT=3000

# Database (Neon / Postgres)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Authentication — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-64-random-hex-characters
JWT_TTL=7d
SESSION_SECRET_KEY=change-me-too

# Comma-separated list of sites allowed to call the API (no trailing slash)
CORS_ORIGIN=http://localhost:9000

# Set to 1 when running behind a hosting proxy (Render, Railway, Fly, Heroku, Nginx)
TRUST_PROXY=1

# TEMPORARY: accept old clients that send the bare uid. Insecure — keep false.
LEGACY_UID_AUTH=false

# Market data providers
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_URL=
CMC_API_KEY=
CMC_API_URL=
COINGECKO_API_KEY=
COINGECKO_URL=
COIN_MARKET_CAP_LISTINGS=
FINNHUB_API_KEY=
LOG_LEVEL=info
WINDOW_SIZE=24h
